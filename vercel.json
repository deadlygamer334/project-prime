{
    "ignoreCommand": "git diff HEAD^ HEAD --quiet .",
    "installCommand": "npm install --legacy-peer-deps",
    "headers": [
        {
            "source": "/api/quotes",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/api/ambience",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, s-maxage=3600, stale-while-revalidate=86400"
                }
            ]
        },
        {
            "source": "/public/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}